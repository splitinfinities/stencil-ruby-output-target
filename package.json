{
  "name": "stencil-ruby-output-target",
  "version": "0.0.0",
  "description": "Stencil output target that generates a Ruby gem from your web components: ViewComponents, helpers, a FormBuilder, head tags with preloads, RBS and tests, for Rails, Sinatra or Bridgetown.",
  "keywords": [
    "stencil",
    "stenciljs",
    "output-target",
    "ruby",
    "rails",
    "view_component",
    "sinatra",
    "bridgetown",
    "web-components"
  ],
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./runtime": "./runtime/stencil-bridge.ts",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "stencil-ruby-output-target": "dist/cli.js"
  },
  "files": [
    "dist/",
    "runtime/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "cli": "node src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/generator.test.ts",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "release": "node scripts/release.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@stencil/core": "^4.45.2"
  },
  "peerDependenciesMeta": {
    "@herb-tools/node": {
      "optional": true
    },
    "@herb-tools/node-wasm": {
      "optional": true
    },
    "@herb-tools/client": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@herb-tools/client": "0.11.0",
    "@herb-tools/node-wasm": "0.11.0",
    "@stencil/core": "^4.45.2",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "playwright": "^1.64.0",
    "typescript": "5.9.3"
  }
}
